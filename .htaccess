# Deny access to documentation and markdown files
<FilesMatch "\.md$">
    Require all denied
</FilesMatch>

# Deny access to local config, composer files and dotfiles
<FilesMatch "^(config\.php|config-default\.php|function\.php|composer\.(json|lock)|phpstan\.neon|docker-compose\.yml|Dockerfile|\..+)$">
    Require all denied
</FilesMatch>

# Deny access to internal directories
RedirectMatch 404 /(vendor|templates|templates_c|cache|configs|data|lib|lang|bin|tests|deploy|doc|docs|stubs|\.git|\.github)(/|$)

Options -Indexes

# pass the Authorization header to PHP (REST API tokens)
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
</IfModule>
